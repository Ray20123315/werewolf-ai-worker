{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": ".test-build"
  },
  "include": ["src/types.ts", "src/roles.ts", "src/auth.ts", "src/ai.ts", "src/translate.ts", "src/game-engine.ts"]
}
